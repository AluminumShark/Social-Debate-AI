# Social Debate AI - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# Required Configuration
# =============================================================================

# OpenAI API Key (Required for full functionality)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# LangGraph Configuration
# =============================================================================

# Use LangGraph Orchestrator (default: true)
# Set to 'false' to use legacy ParallelOrchestrator
USE_LANGGRAPH=true

# =============================================================================
# Flask Configuration
# =============================================================================

# Flask environment (development/production)
FLASK_ENV=development

# Enable Flask debug mode (1=enabled, 0=disabled)
FLASK_DEBUG=1

# Server host and port
HOST=0.0.0.0
PORT=5000

# =============================================================================
# Model Configuration (Optional - can also be set in configs/system.yaml)
# =============================================================================

# OpenAI Model Settings
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MAX_TOKENS=1000
# OPENAI_TEMPERATURE=0.7

# =============================================================================
# Development Settings
# =============================================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Enable verbose output for debugging
# VERBOSE=false
