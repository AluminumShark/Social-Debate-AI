# ============================================================
# Social Debate AI — environment template
# Copy to .env and fill in real values:  cp env.example .env
# .env is gitignored; never commit real keys.
# ============================================================

# ---- LLM provider ----
# provider: ollama | openai | openai-compatible
# Default is a local/LAN Ollama exposing an OpenAI-compatible API.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.6:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_EMBEDDING_MODEL=embeddinggemma:latest
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512

# Let frontend users supply their own model/key per request (recommended).
ALLOW_BYOK=true

# ---- Cloud example (uncomment to use a hosted model instead) ----
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.5
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here

# ---- Test machine (local dev only; leave blank in shared envs) ----
TESTBOX_HOST=
TESTBOX_USER=
TESTBOX_PASSWORD=
TESTBOX_HOSTKEY=

# ---- Flask ----
FLASK_DEBUG=false
